# ICPF Camp Registration System (2026 Edition) - Environment Configuration Template

# Server Port
PORT=5000

# Runtime Environment (development | production | test)
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB: mongodb://127.0.0.1:27017/icpf_camp_2026
# Docker/Atlas: mongodb+srv://<user>:<password>@cluster.mongodb.net/icpf_camp_2026
MONGO_URI=mongodb://127.0.0.1:27017/icpf_camp_2026

# Allowed Frontend Client Origins for CORS (comma-separated or single origin)
CLIENT_URL=http://localhost:5173
